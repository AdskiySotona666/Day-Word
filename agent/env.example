# Скопируй этот файл в .env и впиши свой ключ. Файл .env НЕ коммитить!

# OpenRouter (ключ: openrouter.ai/keys)
API_KEY=sk-or-...
BASE_URL=https://openrouter.ai/api/v1
# Модель должна поддерживать tool calling (вызов инструментов)
MODEL=openai/gpt-4o-mini

# Вариант с Ollama (локально):
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen3:8b
